<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultNetCoreTargetFramework)-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS"  />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\gip.iplus.client.avui\gip.iplus.client.avui.csproj" />
  </ItemGroup>

  <!-- Swashbuckle.AspNetCore.Swagger (transitive dependency) adds a FrameworkReference to
       Microsoft.AspNetCore.App, which has no runtime pack for ios-* RIDs (NETSDK1082).
       The iOS client does not host ASP.NET Core services, so remove the framework
       reference before runtime pack resolution. -->
  <Target Name="RemoveAspNetCoreFrameworkReference" BeforeTargets="ResolveFrameworkReferences">
    <ItemGroup>
      <FrameworkReference Remove="Microsoft.AspNetCore.App" />
    </ItemGroup>
  </Target>
</Project>
