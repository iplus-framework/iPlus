<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="Logging">
      <section name="LoggingConfiguration" type="gip.core.autocomponent.LoggingConfiguration, gip.core.autocomponent, Version=1.0.0.0, Culture=neutral, PublicKeyToken=12adb6357a02d860" allowLocation="true" allowDefinition="Everywhere" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="iPlusV5_Entities"
       connectionString="Integrated Security=True;
		 Encrypt=False;
		 data source=gipDLVmSQL1.incus;
		 initial catalog=iPlusV5;
		 Trusted_Connection=False;
		 persist security info=True;
		 user id=gip;
		 password=netspirit;
		 multipleactiveresultsets=True;
		 application name=iPlus"/>
  </connectionStrings>
  <!--
    Logging configuration for the iPlus console (agent-friendly).
    Log files are written to the directory configured in Path (relative to the
    working directory of the process). MessageType values: Debug, Info, Warning,
    Failure, Error, Exception, Command or Default (logs everything).
    To debug via log files instead of console output, add/adjust LoggingTypes here.
  -->
  <Logging>
    <LoggingConfiguration Path="./Logs">
      <LoggingTypes>
        <addLoggingType FileType="DebugLog" MessageType="Default" Source="*" />
      </LoggingTypes>
      <LogFiles>
        <addLogFile FileType="DebugLog" FileName="iPlusConsoleDebugLog_%Date%" MaxSizeMB="10" />
      </LogFiles>
    </LoggingConfiguration>
  </Logging>
</configuration>
