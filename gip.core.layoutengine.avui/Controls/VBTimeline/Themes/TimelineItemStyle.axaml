<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:le="clr-namespace:gip.core.layoutengine.avui"
    xmlns:local="clr-namespace:gip.core.layoutengine.avui.timeline">

    <ControlTheme x:Key="{x:Type local:TimelineItem}" TargetType="local:TimelineItem">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Avalonia: ContentPresenter does not auto-bind to the templated
                     parent's Content/ContentTemplate (unlike WPF) - bind explicitly,
                     otherwise the DataTemplate is never materialized. -->
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>