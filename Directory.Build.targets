<Project>
	<!--
		Packaging configuration for all packable gip.* projects.

		This must live in Directory.Build.targets (NOT .props) because:
		- the packable decision depends on the FINAL IPlusSourceRepoRoot, which
		  dependent repos (iPlusMES) override after importing iPlus's
		  Directory.Build.props, and
		- item fixups (icon.png, readme.md, DbScripts, VBControlScripts) must run
		  after the default items have been globbed.

		IMPORTANT: multi-targeted projects are packed from the OUTER (cross-targeting)
		evaluation, which does NOT glob default items. Therefore icon.png/readme.md
		are Remove+Include'd (not Update'd) so they exist in both evaluations.

		Dependent repos (iPlusMES) import this file from their own
		Directory.Build.targets.
	-->
	<PropertyGroup>
		<!-- Only projects inside an iPlus source repo are packable -->
		<IPlusIsSourceRepoProject Condition="'$(IPlusIsSourceRepoProject)' == '' and $(MSBuildProjectDirectory.StartsWith('$(IPlusSourceRepoRoot)'))">true</IPlusIsSourceRepoProject>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IPlusIsSourceRepoProject)' == 'true' and '$(UsingMicrosoftNETSdk)' == 'true' and !$(MSBuildProjectName.Contains('Backup')) and !$(IPlusPackExclude.Contains('$(MSBuildProjectName);'))">
		<IPlusIsPackable>true</IPlusIsPackable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IPlusIsPackable)' == 'true'">
		<!-- Web/WebAssembly SDKs (e.g. Microsoft.NET.Sdk.WebAssembly used by the
		     Browser client) set IsPackable=false in Microsoft.NET.Sdk.Web.ProjectSystem.props;
		     re-assert it so pack-local.sh can pack them. -->
		<IsPackable>true</IsPackable>
		<!-- Package IDs get an additional "iPlus." prefix (nuget.org has the "gip"
		     prefix reserved by another owner). Assembly names / namespaces /
		     project names remain unchanged. -->
		<PackageId>iPlus.$(MSBuildProjectName)</PackageId>
		<!-- Force the suite version (per-suite versioning) -->
		<Version>$(IPlusSuitePackageVersion)</Version>
		<Authors Condition="'$(Authors)' == ''">iplus-framework</Authors>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<!-- Fallback license for projects that don't declare one themselves.
		     gip holds the copyright on its own packages, so they are dual-licensed:
		     usable under the open (GPL-3) edition and under a commercial runtime
		     license. See docs/HANDOVER-dual-licensing-distribution.md, section 7. -->
		<PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == '' and '$(PackageLicenseFile)' == '' and '$(PackageLicenseUrl)' == ''">GPL-3.0-or-later OR LicenseRef-Commercial</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageOutputPath>$(IPlusSourceRepoRoot)local-packages</PackageOutputPath>
		<!-- Do not treat the repo's own output folder as package content -->
		<NoPackageAnalysis>true</NoPackageAnalysis>
	</PropertyGroup>

	<!--
		Legacy gip.ext.* projects produce no PDBs, so their symbol packages would be
		empty. nuget.org rejects empty .snupkg files with 400 ("does not contain any
		symbol (.pdb) files)"), which aborts 'dotnet nuget push local-packages/*.nupkg'.
		Disable symbol generation for them.
	-->
	<PropertyGroup Condition="'$(IPlusIsPackable)' == 'true' and ($(MSBuildProjectName.StartsWith('gip.ext.design')) or $(MSBuildProjectName.StartsWith('gip.ext.widgets')) or $(MSBuildProjectName.StartsWith('gip.ext.xamldom')))">
		<IncludeSymbols>false</IncludeSymbols>
	</PropertyGroup>

	<!-- Set icon/readme metadata when the files exist in the project directory;
	     clear it when they are missing (some csprojs declare them unconditionally) -->
	<PropertyGroup Condition="'$(IPlusIsPackable)' == 'true' and Exists('$(MSBuildProjectDirectory)/icon.png')">
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IPlusIsPackable)' == 'true' and !Exists('$(MSBuildProjectDirectory)/icon.png')">
		<PackageIcon></PackageIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IPlusIsPackable)' == 'true' and Exists('$(MSBuildProjectDirectory)/readme.md')">
		<PackageReadmeFile>readme.md</PackageReadmeFile>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IPlusIsPackable)' == 'true' and !Exists('$(MSBuildProjectDirectory)/readme.md')">
		<PackageReadmeFile></PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup Condition="'$(IPlusIsPackable)' == 'true'">
		<!-- Standard package metadata files, if present in the project directory -->
		<None Remove="icon.png" Condition="Exists('$(MSBuildProjectDirectory)/icon.png')" />
		<None Include="icon.png"
					Pack="true"
					PackagePath="\"
					Condition="Exists('$(MSBuildProjectDirectory)/icon.png')" />
		<None Remove="readme.md" Condition="Exists('$(MSBuildProjectDirectory)/readme.md')" />
		<None Include="readme.md"
					Pack="true"
					PackagePath="\"
					Condition="Exists('$(MSBuildProjectDirectory)/readme.md')" />

		<!--
			Ship DbScripts and VBControlScripts inside the package and copy them to the
			consumer's output directory via buildTransitive targets (see
			IPlus.Package.Content.targets). The targets file is parameterized with
			$(MSBuildThisFileDirectory) at consume time, so one shared template works
			for every package.

			Update (not Remove+Include) is used here to preserve existing metadata
			(e.g. CopyToOutputDirectory on explicitly included scripts).
			%(Identity) is the project-relative path, so the package path becomes
			content/DbScripts/... and content/VBControlScripts/...
		-->
		<None Include="$(MSBuildThisFileDirectory)build/IPlus.Package.Content.targets"
					Pack="true"
					PackagePath="buildTransitive/$(PackageId).targets"
					Condition="Exists('$(MSBuildProjectDirectory)/DbScripts') or Exists('$(MSBuildProjectDirectory)/VBControlScripts')" />
		<None Update="DbScripts/**/*.*"
					Pack="true"
					PackagePath="content/%(Identity)"
					Condition="Exists('$(MSBuildProjectDirectory)/DbScripts')" />
		<None Update="VBControlScripts/**/*.*"
					Pack="true"
					PackagePath="content/%(Identity)"
					Condition="Exists('$(MSBuildProjectDirectory)/VBControlScripts')" />
	</ItemGroup>

        <!--
                SQL Tunnel debugging (Option B): replace the Microsoft.Data.SqlClient package
                assets with a direct project reference to the forked SqlClient. ExcludeAssets=all
                strips the package's compile/runtime assets (including transitive flow from the
                iPlus.EntityFrameworkCore.* packages) while keeping the dependency graph intact;
                the sibling packages (Abstractions, Internal.Logging, SqlServer.Server) still come
                from the package graph at matching versions.
        -->
        <ItemGroup Condition="'$(UseSqlClientForkProjectReference)' == 'True' and Exists('$(SqlClientForkProject)')">
                <PackageReference Update="Microsoft.Data.SqlClient" ExcludeAssets="all" />
                <!-- The iPlus fork package (same assembly identity) must also be stripped in
                     project-reference mode, otherwise RAR resolves the stale packaged DLL
                     instead of the freshly built fork (observed 2026-10-13: the browser
                     client kept serving the 7.1.1-iplus.2 package DLL). ExcludeAssets only
                     affects the project where the PackageReference is declared, so an
                     Include (not Update) is injected into EVERY project — a direct excluded
                     reference overrides the transitive flow of the same package id. -->
                <!-- Update first: projects that declare the package directly keep their single
                     item (avoids NU1504 duplicate); the conditional Include only fires when
                     the project has no explicit reference of its own. -->
                <PackageReference Update="iPlus.Microsoft.Data.SqlClient" ExcludeAssets="all" />
                <PackageReference Include="iPlus.Microsoft.Data.SqlClient" ExcludeAssets="all"
                                  Condition="'@(PackageReference->WithMetadataValue('Identity','iPlus.Microsoft.Data.SqlClient'))' == ''" />
                <ProjectReference Include="$(SqlClientForkProject)" AdditionalProperties="SigningKeyPath=$(SqlClientForkSigningKey)" />
        </ItemGroup>

        <!--
                SQL Tunnel package mode (default): iPlus.Microsoft.Data.SqlClient comes from
                the packages-local feed (see Directory.Packages.props). The official
                Microsoft.Data.SqlClient still flows in transitively from the
                iPlus.EntityFrameworkCore.* packages — strip its assets so only the fork
                assembly (same assembly name Microsoft.Data.SqlClient) is referenced/ copied.
        -->
        <ItemGroup Condition="'$(UseSqlClientForkProjectReference)' != 'True'">
                <PackageReference Update="Microsoft.Data.SqlClient" ExcludeAssets="all" />
        </ItemGroup>

        <!--
                ============================================================================
                Package license metadata (GPL vs. commercial)
                ============================================================================

                Every assembly carries its license expression as
                [assembly: AssemblyMetadata("iPlusLicense", "<SPDX expression>")].
                The runtime reads it in ACClassManager.RegisterAssemblyTypes and uses it
                to prevent mixing GPL-3 packages with a commercially licensed runtime
                (see docs/HANDOVER-dual-licensing-distribution.md, section 7).

                WHY A GENERATED .g.cs FILE AND NOT <AssemblyAttribute>:
                All projects in this repo set <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
                (they ship hand-written Properties/AssemblyInfo.cs). The SDK's
                GetAssemblyAttributes target is gated on GenerateAssemblyInfo == true, so
                the <AssemblyAttribute> item is silently ignored here. Writing a small
                generated source file and adding it to Compile works regardless.

                WHY AssemblyMetadataAttribute AND NOT A CUSTOM ATTRIBUTE:
                AssemblyMetadataAttribute is a BCL type, so gip.core.licensing (which is
                deliberately dependency-free) can read it without referencing anything.
                A custom attribute would force every package to reference a shared
                assembly.

                WHY .targets AND NOT .props:
                PackageLicenseExpression is set inside the csproj, so it is only final
                after the project body has been evaluated.

                OVERRIDE FOR COMMERCIAL PACKAGES:
                  <PropertyGroup>
                    <IPlusLicenseExpression>Commercial</IPlusLicenseExpression>
                  </PropertyGroup>
        -->
        <PropertyGroup>
                <!-- Derive from the NuGet license expression so that no csproj needs editing.
                     gip.ext.opctoolbox declares MIT and therefore stays MIT. -->
                <IPlusLicenseExpression Condition="'$(IPlusLicenseExpression)' == '' and '$(PackageLicenseExpression)' != ''">$(PackageLicenseExpression)</IPlusLicenseExpression>
                <IPlusLicenseExpression Condition="'$(IPlusLicenseExpression)' == ''">GPL-3.0-or-later</IPlusLicenseExpression>
        </PropertyGroup>

        <!-- Runs per target framework (inner build), so multi-targeted projects each get
             their own generated file in their own IntermediateOutputPath. -->
        <Target Name="GenerateIPlusLicenseAttribute"
                BeforeTargets="BeforeCompile;CoreCompile"
                Condition="'$(IPlusLicenseExpression)' != ''">
                <PropertyGroup>
                        <_IPlusLicenseFile>$(IntermediateOutputPath)iPlusLicenseInfo.g.cs</_IPlusLicenseFile>
                </PropertyGroup>
                <WriteLinesToFile File="$(_IPlusLicenseFile)"
                                  Overwrite="true"
                                  WriteOnlyWhenDifferent="true"
                                  Lines="// &lt;auto-generated/&gt;%0A[assembly: System.Reflection.AssemblyMetadata(&quot;iPlusLicense&quot;, &quot;$(IPlusLicenseExpression)&quot;)]" />
                <ItemGroup>
                        <Compile Include="$(_IPlusLicenseFile)" />
                        <FileWrites Include="$(_IPlusLicenseFile)" />
                </ItemGroup>
        </Target>
</Project>
