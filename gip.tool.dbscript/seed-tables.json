{
  // Seed / master data configuration for the iPlus-framework initial-install script.
  //
  // Reference database: iPlusV5 (framework only — no MES tables).
  //
  // Only tables listed here are exported. Everything else (production orders,
  // postings, logs, runtime state, customer master data) is deliberately left
  // out: the generated script must be safe to hand to any new customer.
  //
  // A trailing '*' in "name" is a prefix wildcard. "filter" is appended as a
  // WHERE clause (without the keyword). "insertOnlyWhenEmpty" (default true)
  // wraps the INSERTs in an IF NOT EXISTS guard so the script is idempotent.
  //
  // Review this file whenever the EF model gains a new master-data table.

  "defaultSchema": "dbo",

  "tables": [
    // ---------------------------------------------------------------- iPlus
    // Framework model: classes, properties, methods, workflows, designs.
    { "name": "ACProject" },
    { "name": "ACPackage" },
    { "name": "ACClass" },
    { "name": "ACClassProperty" },
    { "name": "ACClassPropertyRelation" },
    { "name": "ACClassMethod" },
    { "name": "ACClassMethodConfig" },
    { "name": "ACClassConfig" },
    { "name": "ACClassText" },
    { "name": "ACClassMessage" },
    { "name": "ACClassDesign" },
    { "name": "ACClassWF" },
    { "name": "ACClassWFEdge" },
    // Startup node and its live instance tree: ACStartUpRoot builds the ACRoot
    // instance from the top-level task; ACComponent.Construct then resolves the
    // child components (Environment, Communications, Businessobjects, Messages,
    // DataAccess, Service, Queries, LocalServiceObjects) as tasks *nested under
    // their parent task* (ACClassTask.ParentACClassTaskID). Missing child tasks
    // make Construct fail with "content == null". Machine-specific subtrees
    // (S7Service/PLC1/… on the reference DB) are exported too — they stay
    // dormant unless their project is started. Testmode tasks are excluded.
    { "name": "ACClassTask", "filter": "IsTestmode = 0" },
    { "name": "ACAssembly" },

    // Framework configuration and security.
    { "name": "VBConfig" },
    { "name": "VBGroup" },
    { "name": "VBGroupRight" },
    { "name": "VBLanguage" },
    { "name": "VBNoConfiguration" },
    { "name": "VBSystem" },
    { "name": "VBUserGroup" },

    // Only superusers are exported; customer users must not leak into the
    // distribution. The installer creates the initial admin account.
    // NOTE: VBUser must be listed BEFORE its children VBUserACProject /
    // VBUserACClassDesign (FK_VBUserACProject_VBUserID and
    // FK_VBUserACClassDesign_VBUserID) — sections are applied in list order.
    { "name": "VBUser", "filter": "IsSuperuser = 1" },
    { "name": "VBUserACProject" },
    { "name": "VBUserACClassDesign" },

    // Schema-sync bookkeeping (needed so dbsyncer knows what is already applied).
    { "name": "DbSyncerInfoContext" },
    { "name": "DbSyncerInfo" },
    { "name": "DBSyncerVersion" },
    { "name": "ControlScriptSyncInfo" }
  ],

  "excludeTables": [
    // Runtime / log tables that must never be part of a fresh install.
    // NOTE: ACClassTask is intentionally NOT excluded: the ACRoot task below the
    // Root project's root class is the application's startup node — ACStartUpRoot
    // needs it (taskTypeACClass) to build the ACRoot instance. ACClassTaskValue /
    // ACClassTaskValuePos stay excluded (runtime state).
    "dbo.ACChangeLog",
    "dbo.ACProgram",
    "dbo.ACProgramConfig",
    "dbo.ACProgramLog",
    "dbo.ACProgramLogPropertyLog",
    "dbo.ACProgramLogTask",
    "dbo.ACPropertyLog",
    "dbo.ACPropertyLogRule",
    "dbo.ACClassTaskValue",
    "dbo.ACClassTaskValuePos",
    "dbo.ACClassRouteUsage",
    "dbo.ACClassRouteUsageGroup",
    "dbo.ACClassRouteUsagePos",
    "dbo.MsgAlarmLog",
    "dbo.VBUserInstance",
    "dbo.VBLicense"
  ]
}
