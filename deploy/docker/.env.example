# Copy to deploy/docker/.env and edit. Never commit the real .env file.
#
# The SA password must satisfy the SQL Server complexity policy:
# at least 8 characters, with upper case, lower case, digits and symbols.

# SQL Server
MSSQL_SA_PASSWORD=ChangeMe!2026
MSSQL_PID=Developer
MSSQL_PORT=1433

# iPlus database
IPLUS_DB_NAME=iPlusV5

# Suite version (must match the artifacts produced by build/publish-release.sh)
IPLUS_VERSION=5.0.0

# Published ports
IPLUS_HTTP_PORT=8080
IPLUS_TUNNEL_PORT=8751

# Container timezone
TZ=UTC
