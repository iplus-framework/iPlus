# syntax=docker/dockerfile:1

# Static web server for the iPlus browser client (Blazor/Avalonia WASM).
#
# The image does NOT build the client. It consumes the published output of
# build/publish-release.sh (platform "browser"):
#
#   ./build/publish-release.sh --platform browser --keep-intermediate
#
# then:
#
#   docker build -f deploy/docker/Dockerfile.browser \
#     --build-arg IPLUS_VERSION=5.0.0 \
#     -t iplus-browser:5.0.0 .
#
# The publish output is expected in artifacts/release/.work/iplus-<version>-browser.

FROM nginx:1.27-alpine

ARG IPLUS_VERSION=5.0.0

# WASM needs the correct MIME types and must not be cached aggressively.
RUN rm -rf /usr/share/nginx/html/*

COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY artifacts/release/.work/iplus-${IPLUS_VERSION}-browser/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
